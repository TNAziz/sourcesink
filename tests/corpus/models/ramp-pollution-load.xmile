<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Ramp Pollution Load</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="year">
    <start>0</start>
    <stop>12</stop>
    <dt>0.01</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="LoadStock">
        <eqn>0</eqn>
        <inflow name="Ramp_load"/>
      </stock>
      <flow name="Ramp_load">
        <eqn>RAMP(0.5, 2)</eqn>
      </flow>
    </variables>
  </model>
</xmile>
