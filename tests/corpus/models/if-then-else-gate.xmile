<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>IF/THEN/ELSE Delivery Gate</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="hour">
    <start>0</start>
    <stop>10</stop>
    <dt>0.5</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Delivered">
        <eqn>0</eqn>
        <inflow name="Gate"/>
      </stock>
      <flow name="Gate">
        <eqn>IF TIME &lt; 5 THEN 0 ELSE 2</eqn>
      </flow>
    </variables>
  </model>
</xmile>
