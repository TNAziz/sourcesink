<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Two-Box Carbon Exchange</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="year">
    <start>0</start>
    <stop>200</stop>
    <dt>0.01</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Atmosphere">
        <eqn>800</eqn>
        <outflow name="Uptake"/>
      </stock>
      <stock name="Ocean">
        <eqn>200</eqn>
        <inflow name="Uptake"/>
      </stock>
      <flow name="Uptake" biflow="true">
        <eqn>0.02 * Atmosphere - 0.01 * Ocean</eqn>
      </flow>
    </variables>
  </model>
</xmile>
