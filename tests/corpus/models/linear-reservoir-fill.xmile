<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Linear Reservoir Fill</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>0.5</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Storage">
        <eqn>10</eqn>
        <inflow name="Inflow"/>
        <doc>Water stored in the pond, filled at a constant diversion rate.</doc>
      </stock>
      <flow name="Inflow">
        <eqn>2</eqn>
        <doc>Constant diversion of 2 units per day.</doc>
      </flow>
    </variables>
  </model>
</xmile>
