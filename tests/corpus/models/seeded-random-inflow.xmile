<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Seeded Random Catch</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="month">
    <start>0</start>
    <stop>10</stop>
    <dt>0.5</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Catch">
        <eqn>0</eqn>
        <inflow name="Random_inflow"/>
      </stock>
      <flow name="Random_inflow">
        <eqn>RANDOM(0, 2, 12345)</eqn>
      </flow>
    </variables>
  </model>
</xmile>
