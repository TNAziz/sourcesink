<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Spill from a Non-Negative Tank</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>5</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Tank" non_negative="true">
        <eqn>10</eqn>
        <outflow name="Spill"/>
      </stock>
      <stock name="Creek">
        <eqn>0</eqn>
        <inflow name="Spill"/>
      </stock>
      <flow name="Spill">
        <eqn>4</eqn>
      </flow>
    </variables>
  </model>
</xmile>
