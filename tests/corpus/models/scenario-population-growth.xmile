<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0" xmlns:ss="https://sourcesink.dev/xmile/1">
  <header>
    <name>Population Growth Scenarios</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="year">
    <start>0</start>
    <stop>10</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Population">
        <eqn>100</eqn>
        <inflow name="Growth"/>
      </stock>
      <flow name="Growth">
        <eqn>Growth_rate * Population</eqn>
      </flow>
      <aux name="Growth_rate">
        <eqn>0.1</eqn>
      </aux>
    </variables>
    <ss:scenarios>
      <ss:scenario id="high" name="High growth">
        <ss:override name="Growth_rate">0.2</ss:override>
      </ss:scenario>
    </ss:scenarios>
  </model>
</xmile>
