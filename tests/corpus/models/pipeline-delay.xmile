<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Pipeline Transport Delay</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="hour">
    <start>0</start>
    <stop>10</stop>
    <dt>0.5</dt>
    <saveper>0.5</saveper>
  </sim_specs>
  <model>
    <variables>
      <aux name="Inflow">
        <eqn>RAMP(1, 0)</eqn>
      </aux>
      <aux name="Delayed">
        <eqn>DELAY(Inflow, 3, 0)</eqn>
      </aux>
    </variables>
  </model>
</xmile>
