<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>SMTH1 Sensor Lag</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="hour">
    <start>0</start>
    <stop>30</stop>
    <dt>0.5</dt>
    <saveper>0.5</saveper>
  </sim_specs>
  <model>
    <variables>
      <aux name="Reading">
        <eqn>STEP(1, 2)</eqn>
      </aux>
      <aux name="Smooth_reading">
        <eqn>SMTH1(Reading, 5)</eqn>
      </aux>
    </variables>
  </model>
</xmile>
