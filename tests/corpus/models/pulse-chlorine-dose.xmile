<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Pulse Chlorine Dosing</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>12</stop>
    <dt>0.5</dt>
    <saveper>0.5</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Chlorine">
        <eqn>0</eqn>
        <inflow name="Dose"/>
      </stock>
      <flow name="Dose">
        <eqn>PULSE(12, 3, 5)</eqn>
      </flow>
    </variables>
  </model>
</xmile>
