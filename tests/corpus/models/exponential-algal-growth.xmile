<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Exponential Algal Growth</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>0.005</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Algae">
        <eqn>50</eqn>
        <inflow name="Growth"/>
      </stock>
      <flow name="Growth">
        <eqn>0.2 * Algae</eqn>
      </flow>
    </variables>
  </model>
</xmile>
