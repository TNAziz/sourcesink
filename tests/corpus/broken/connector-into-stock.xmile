<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Connector Into a Stock</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="Storage">
        <eqn>0</eqn>
        <inflow name="Flow"/>
      </stock>
      <flow name="Flow">
        <eqn>Rate</eqn>
      </flow>
      <aux name="Rate">
        <eqn>1</eqn>
      </aux>
    </variables>
    <views>
      <view type="stock_flow">
        <connector from="Rate" to="Storage"/>
      </view>
    </views>
  </model>
</xmile>
