<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Graph Function Wrong Arity</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="S">
        <eqn>0</eqn>
        <inflow name="Flow"/>
      </stock>
      <flow name="Flow">
        <eqn>1</eqn>
      </flow>
      <aux name="X">
        <eqn>Rating(1, 2)</eqn>
      </aux>
      <gf name="Rating" interpolation="linear" extrapolation="clip">
        <xpts>0,1</xpts>
        <ypts>0,1</ypts>
      </gf>
    </variables>
  </model>
</xmile>
