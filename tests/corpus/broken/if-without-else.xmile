<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>IF Without ELSE</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="S">
        <eqn>0</eqn>
        <inflow name="Flow"/>
      </stock>
      <flow name="Flow">
        <eqn>IF TIME &gt; 5 THEN 1</eqn>
      </flow>
    </variables>
  </model>
</xmile>
