<?xml version="1.0" encoding="UTF-8"?>
<xmile version="1.0">
  <header>
    <name>Square Root of a Negative</name>
    <vendor>SourceSink</vendor>
    <product version="0.1.0">SourceSink</product>
  </header>
  <sim_specs method="Euler" time_units="day">
    <start>0</start>
    <stop>10</stop>
    <dt>1</dt>
    <saveper>1</saveper>
  </sim_specs>
  <model>
    <variables>
      <stock name="S">
        <eqn>100</eqn>
        <outflow name="Loss"/>
      </stock>
      <flow name="Loss">
        <eqn>Bad</eqn>
      </flow>
      <aux name="Bad">
        <eqn>SQRT(-1)</eqn>
      </aux>
    </variables>
  </model>
</xmile>
